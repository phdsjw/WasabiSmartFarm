    {
        "id": "parse_soil_data",
        "type": "function",
        "z": "main_tab",
        "name": "토양 데이터 파싱",
        "func": "// 토양 센서 데이터 파싱 및 차트 준비\nconst data = msg.payload;\nconst tankId = msg.topic.split('/')[2];\n\n// 개별 센서 데이터를 차트용으로 변환\nmsg.soil_temp = {\n    topic: `Tank ${tankId}`,\n    payload: data.soil_temp\n};\n\nmsg.soil_moisture = {\n    topic: `Tank ${tankId}`,\n    payload: data.soil_moisture\n};\n\nmsg.soil_ec = {\n    topic: `Tank ${tankId}`,\n    payload: data.soil_ec\n};\n\nmsg.soil_ph = {\n    topic: `Tank ${tankId}`,\n    payload: data.soil_ph\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            ["chart_soil_temp", "chart_soil_moisture", "chart_soil_ec", "chart_soil_ph"]
        ]
    },
    {
        "id": "parse_air_data",
        "type": "function",
        "z": "main_tab",
        "name": "대기 데이터 파싱",
        "func": "// 대기 센서 데이터 파싱 및 차트 준비\nconst data = msg.payload;\nconst zoneId = msg.topic.split('/')[2];\n\nmsg.air_temp = {\n    topic: `Zone ${zoneId}`,\n    payload: data.air_temp\n};\n\nmsg.air_humidity = {\n    topic: `Zone ${zoneId}`,\n    payload: data.air_humidity\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 200,
        "wires": [
            ["chart_air_temp", "chart_air_humidity"]
        ]
    },
    {
        "id": "parse_water_data",
        "type": "function",
        "z": "main_tab",
        "name": "수조 데이터 파싱",
        "func": "// 수조 센서 데이터 파싱\nconst data = msg.payload;\n\nmsg.water_temp = {\n    topic: \"수온\",\n    payload: data.water_temp\n};\n\nmsg.water_ph = {\n    topic: \"pH\",\n    payload: data.water_ph\n};\n\nmsg.water_ec = {\n    topic: \"EC\",\n    payload: data.water_ec\n};\n\nmsg.water_tds = {\n    topic: \"TDS\",\n    payload: data.water_tds\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 300,
        "wires": [
            ["chart_water_temp", "chart_water_ph_ec", "gauge_water_tds"]
        ]
    },
    {
        "id": "avg_soil_calc",
        "type": "function",
        "z": "main_tab",
        "name": "토양 평균값 계산",
        "func": "// 토양 센서 18개의 평균값 계산\nconst data = msg.payload;\nconst tankId = msg.topic.split('/')[2];\n\n// Context에 센서 데이터 저장 (18개)\nlet soilData = context.get('soilData') || {};\nsoilData[tankId] = {\n    soil_temp: data.soil_temp,\n    soil_moisture: data.soil_moisture,\n    soil_ec: data.soil_ec,\n    soil_ph: data.soil_ph,\n    timestamp: Date.now()\n};\ncontext.set('soilData', soilData);\n\n// 10분 이상 오래된 데이터 제거\nconst now = Date.now();\nfor (let key in soilData) {\n    if (now - soilData[key].timestamp > 600000) {\n        delete soilData[key];\n    }\n}\n\n// 평균값 계산\nconst keys = Object.keys(soilData);\nif (keys.length === 0) return null;\n\nlet avgTemp = 0, avgMoisture = 0, avgEC = 0, avgPH = 0;\nfor (let key of keys) {\n    avgTemp += soilData[key].soil_temp;\n    avgMoisture += soilData[key].soil_moisture;\n    avgEC += soilData[key].soil_ec;\n    avgPH += soilData[key].soil_ph;\n}\n\nconst count = keys.length;\nmsg.payload = {\n    soil_temp_avg: Math.round(avgTemp / count * 10) / 10,\n    soil_moisture_avg: Math.round(avgMoisture / count * 10) / 10,\n    soil_ec_avg: Math.round(avgEC / count * 10) / 10,\n    soil_ph_avg: Math.round(avgPH / count * 100) / 100,\n    sensor_count: count\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 120,
        "wires": [
            ["display_soil_avg", "auto_irrigation_check"]
        ]
    },
    {
        "id": "avg_air_calc",
        "type": "function",
        "z": "main_tab",
        "name": "대기 평균값 계산",
        "func": "// 대기 센서 3개의 평균값 계산\nconst data = msg.payload;\nconst zoneId = msg.topic.split('/')[2];\n\n// Context에 센서 데이터 저장 (3개)\nlet airData = context.get('airData') || {};\nairData[zoneId] = {\n    air_temp: data.air_temp,\n    air_humidity: data.air_humidity,\n    timestamp: Date.now()\n};\ncontext.set('airData', airData);\n\n// 10분 이상 오래된 데이터 제거\nconst now = Date.now();\nfor (let key in airData) {\n    if (now - airData[key].timestamp > 600000) {\n        delete airData[key];\n    }\n}\n\n// 평균값 계산\nconst keys = Object.keys(airData);\nif (keys.length === 0) return null;\n\nlet avgTemp = 0, avgHumidity = 0;\nfor (let key of keys) {\n    avgTemp += airData[key].air_temp;\n    avgHumidity += airData[key].air_humidity;\n}\n\nconst count = keys.length;\nmsg.payload = {\n    air_temp_avg: Math.round(avgTemp / count * 10) / 10,\n    air_humidity_avg: Math.round(avgHumidity / count * 10) / 10,\n    sensor_count: count\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 220,
        "wires": [
            ["display_air_avg"]
        ]
    },
    {
        "id": "water_chart_prep",
        "type": "function",
        "z": "main_tab",
        "name": "수조 차트 준비",
        "func": "const data = msg.payload;\n\n// 수온 차트\nmsg.water_temp_chart = {\n    payload: data.water_temp\n};\n\n// pH/EC 듀얼 축 차트\nmsg.water_ph_chart = {\n    topic: \"pH\",\n    payload: data.water_ph\n};\n\nmsg.water_ec_chart = {\n    topic: \"EC\",\n    payload: data.water_ec\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 320,
        "wires": [
            []
        ]
    },
