    {
        "id": "auto_irrigation_check",
        "type": "function",
        "z": "main_tab",
        "name": "자동 관수 조건 체크",
        "func": "const avg = msg.payload;\n\n// 자동 모드 확인\nconst autoMode = context.get('autoMode') || false;\nif (!autoMode) return null;\n\n// 관수 중인지 확인\nconst isIrrigating = context.get('isIrrigating') || false;\n\n// 마지막 관수 시간 확인 (1시간 간격)\nconst lastIrrigationTime = context.get('lastIrrigationTime') || 0;\nconst now = Date.now();\nif (now - lastIrrigationTime < 3600000) return null; // 1시간 = 3600000ms\n\n// 관수 시작 조건 (OR)\nif (!isIrrigating) {\n    if (avg.soil_moisture_avg <= 95 || avg.soil_ec_avg >= 5.0 || avg.soil_temp_avg >= 22) {\n        msg.payload = {command: 'start'};\n        context.set('isIrrigating', true);\n        context.set('irrigationStartTime', now);\n        node.warn('자동 관수 시작: 습도=' + avg.soil_moisture_avg + '%, EC=' + avg.soil_ec_avg + ', 온도=' + avg.soil_temp_avg + '°C');\n        return msg;\n    }\n}\n\n// 관수 정지 조건 (AND)\nif (isIrrigating) {\n    const irrigationDuration = now - (context.get('irrigationStartTime') || now);\n    \n    // 4분 타임아웃 또는 조건 충족 시 정지\n    if (irrigationDuration >= 240000 || (avg.soil_moisture_avg > 97 && avg.soil_ec_avg < 3.0)) {\n        msg.payload = {command: 'stop'};\n        context.set('isIrrigating', false);\n        context.set('lastIrrigationTime', now);\n        node.warn('자동 관수 정지: 습도=' + avg.soil_moisture_avg + '%, EC=' + avg.soil_ec_avg);\n        return msg;\n    }\n}\n\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 140,
        "wires": [
            ["mqtt_irrigation_control"]
        ]
    },
    {
        "id": "mqtt_irrigation_control",
        "type": "function",
        "z": "main_tab",
        "name": "MQTT 관수 명령 발행",
        "func": "const command = msg.payload.command;\n\nif (command === 'start') {\n    msg.topic = 'actuator/irrigation_pump/on';\n    msg.payload = '';\n} else if (command === 'stop') {\n    msg.topic = 'actuator/irrigation_pump/off';\n    msg.payload = '';\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 140,
        "wires": [
