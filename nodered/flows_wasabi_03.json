    {
        "id": "heartbeat_timeout_check",
        "type": "function",
        "z": "main_tab",
        "name": "타임아웃 체크 (2분)",
        "func": "const now = Date.now();\nconst timeout = 120000;  // 2분 (120초)\n\n// 모니터링 대상 노드 목록 (전체 21개)\nconst nodes = [\n    // 액추에이터 노드 (1개)\n    { id: 'actuator', name: '액추에이터 노드', critical: true },\n    \n    // 물탱크 센서 (1개)\n    { id: 'water_tank', name: '물탱크 센서', critical: true },\n    \n    // 시스템 컨트롤러 (1개)\n    { id: 'system_controller', name: '시스템 컨트롤러', critical: false },\n    \n    // 대기센서 (1개)\n    { id: 'air_zone1', name: '대기센서 Zone1', critical: true },\n    \n    // 토양센서 (18개)\n    { id: 'soil_01', name: '토양센서 01', critical: true },\n    { id: 'soil_02', name: '토양센서 02', critical: true },\n    { id: 'soil_03', name: '토양센서 03', critical: true },\n    { id: 'soil_04', name: '토양센서 04', critical: true },\n    { id: 'soil_05', name: '토양센서 05', critical: true },\n    { id: 'soil_06', name: '토양센서 06', critical: true },\n    { id: 'soil_07', name: '토양센서 07', critical: true },\n    { id: 'soil_08', name: '토양센서 08', critical: true },\n    { id: 'soil_09', name: '토양센서 09', critical: true },\n    { id: 'soil_10', name: '토양센서 10', critical: true },\n    { id: 'soil_11', name: '토양센서 11', critical: true },\n    { id: 'soil_12', name: '토양센서 12', critical: true },\n    { id: 'soil_13', name: '토양센서 13', critical: true },\n    { id: 'soil_14', name: '토양센서 14', critical: true },\n    { id: 'soil_15', name: '토양센서 15', critical: true },\n    { id: 'soil_16', name: '토양센서 16', critical: true },\n    { id: 'soil_17', name: '토양센서 17', critical: true },\n    { id: 'soil_18', name: '토양센서 18', critical: true }\n];\n\nconst statuses = [];\nconst alerts = [];\n\nnodes.forEach(node => {\n    const lastHB = context.get('hb_' + node.id, 'default') || 0;\n    const elapsed = now - lastHB;\n    \n    let status = '';\n    let color = '';\n    \n    if (lastHB === 0) {\n        status = '연결 안됨';\n        color = 'gray';\n        if (node.critical) {\n            alerts.push({\n                node: node.name,\n                status: 'never_connected',\n                message: '하트비트를 받지 못했습니다'\n            });\n        }\n    } else if (elapsed > timeout) {\n        status = '타임아웃 (' + Math.floor(elapsed/1000) + '초)';\n        color = 'red';\n        alerts.push({\n            node: node.name,\n            status: 'timeout',\n            elapsed: Math.floor(elapsed/1000) + '초',\n            message: '하트비트 타임아웃 발생'\n        });\n    } else {\n        status = '온라인 (' + Math.floor(elapsed/1000) + '초 전)';\n        color = 'green';\n    }\n    \n    statuses.push({\n        id: node.id,\n        name: node.name,\n        status: status,\n        color: color,\n        elapsed: elapsed,\n        lastHB: lastHB,\n        critical: node.critical\n    });\n});\n\n// 상태 표시용 메시지\nconst statusMsg = { payload: statuses };\n\n// 알림용 메시지\nif (alerts.length > 0) {\n    node.warn('⚠️ Heartbeat timeout detected: ' + alerts.length + ' nodes');\n    const alertMsg = {\n        payload: {\n            alert_type: 'heartbeat_timeout',\n            count: alerts.length,\n            nodes: alerts,\n            timestamp: now\n        }\n    };\n    return [statusMsg, alertMsg];\n}\n\nreturn [statusMsg, null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
