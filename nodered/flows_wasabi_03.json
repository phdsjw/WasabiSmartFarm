        "z": "main_tab",
        "name": "하트비트 처리",
        "func": "// 토픽에서 노드 ID 추출\nconst topic = msg.topic;\nlet nodeId = '';\n\nif (topic === 'actuator/heartbeat') {\n    nodeId = 'actuator';\n} else if (topic === 'sensor/water_tank/heartbeat') {\n    nodeId = 'water_tank';\n} else if (topic === 'system/heartbeat') {\n    nodeId = 'system_controller';\n} else if (topic.startsWith('sensor/air/')) {\n    const parts = topic.split('/');\n    nodeId = 'air_' + parts[2];\n} else if (topic.startsWith('sensor/soil/')) {\n    const parts = topic.split('/');\n    nodeId = 'soil_' + parts[2];\n}\n\n// 현재 시간 저장 (영구 저장소 사용)\nconst now = Date.now();\ncontext.set('hb_' + nodeId, now, 'default');\n\n// 로그\nnode.log('Heartbeat received from ' + nodeId);\n\n// 상태 정보 전달\nmsg.payload = {\n    node: nodeId,\n    status: 'online',\n    timestamp: now,\n    raw_data: msg.payload\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
