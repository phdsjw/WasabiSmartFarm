    {
        "id": "parse_heartbeat",
        "type": "function",
        "z": "step1_tab",
        "name": "하트비트 파싱",
        "func": "let data = msg.payload;\n\n// Arduino 연결 상태 저장\nflow.set('arduino_connected', true);\nflow.set('arduino_uptime', data.uptime);\nflow.set('arduino_rssi', data.wifi_rssi);\nflow.set('last_heartbeat', new Date().toISOString());\n\n// 연결 타임아웃 타이머 리셋\nlet timeoutId = flow.get('heartbeat_timeout');\nif (timeoutId) {\n    clearTimeout(timeoutId);\n}\n\n// 2분 후에도 하트비트가 없으면 연결 끊김으로 판단\nlet newTimeoutId = setTimeout(() => {\n    flow.set('arduino_connected', false);\n    node.warn('Arduino 하트비트 타임아웃 - 연결 끊김');\n}, 120000);\n\nflow.set('heartbeat_timeout', newTimeoutId);\n\nnode.status({fill:\"green\", shape:\"dot\", text:`연결됨 (${data.uptime}s, RSSI: ${data.wifi_rssi})`});\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "x": 350,
        "y": 680,
        "wires": [
            ["ui_connection_status"]
        ]
    },
