    {
        "id": "parse_environment",
        "type": "function",
        "z": "step1_tab",
        "name": "환경 데이터 파싱",
        "func": "// JSON 파싱 (자동으로 객체로 변환됨)\nlet data = msg.payload;\n\n// Flow context에 저장\nflow.set('air_temp', data.air_temp);\nflow.set('air_humidity', data.air_humidity);\nflow.set('water_temp', data.water_temp);\nflow.set('water_ph', data.water_ph);\nflow.set('water_tds', data.water_tds);\nflow.set('water_ec', data.water_ec);\n\n// 토양 센서 데이터 저장\nif (data.soil_temp && Array.isArray(data.soil_temp)) {\n    for (let i = 0; i < data.soil_temp.length; i++) {\n        let tankNum = i + 1;\n        flow.set(`tank${tankNum}_soil_temp`, data.soil_temp[i]);\n        flow.set(`tank${tankNum}_soil_moisture`, data.soil_moisture[i]);\n        flow.set(`tank${tankNum}_soil_ec`, data.soil_ec[i]);\n        flow.set(`tank${tankNum}_soil_ph`, data.soil_ph[i]);\n    }\n}\n\n// 로그 기록\nlet now = new Date().toISOString();\nlet logs = flow.get('sensor_logs') || [];\nlogs.push({\n    time: now,\n    air_temp: data.air_temp,\n    air_humidity: data.air_humidity,\n    water_temp: data.water_temp\n});\n\n// 최근 100개만 유지\nif (logs.length > 100) {\n    logs.shift();\n}\nflow.set('sensor_logs', logs);\n\nnode.status({fill:\"green\", shape:\"dot\", text:`수신: ${now}`});\n\n// 개별 출력으로 분리\nreturn [\n    {payload: data.air_temp, topic: 'air_temp'},\n    {payload: data.air_humidity, topic: 'air_humidity'},\n    {payload: data.water_temp, topic: 'water_temp'},\n    {payload: data.water_ph, topic: 'water_ph'},\n    {payload: data.water_tds, topic: 'water_tds'},\n    {payload: data.water_ec, topic: 'water_ec'}\n];",
        "outputs": 6,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 100,
        "wires": [
            ["ui_air_temp", "ui_air_temp_chart"],
            ["ui_air_humidity"],
            ["ui_water_temp"],
            ["ui_water_ph"],
            ["ui_water_tds"],
            ["ui_water_ec"]
        ]
    },
