        "id": "mqtt_in_environment",
        "type": "mqtt in",
        "z": "step1_tab",
        "name": "환경 센서 데이터 수신",
        "topic": "sensor/environment",
        "qos": "1",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 150,
        "y": 100,
        "wires": [
            ["parse_environment", "debug_environment"]
        ]
