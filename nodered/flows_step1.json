    {
        "id": "parse_water_level",
        "type": "function",
        "z": "step1_tab",
        "name": "수위 데이터 파싱",
        "func": "// 토픽에서 탱크 번호 추출: watering/tank01/level\nlet match = msg.topic.match(/watering\\/tank(\\d\\d)\\/level/);\n\nif (!match) {\n    node.warn('Invalid topic format');\n    return null;\n}\n\nlet tankNum = match[1];  // \"01\", \"02\", ...\nlet level = parseInt(msg.payload);\n\n// Flow context에 저장\nflow.set(`tank${tankNum}_water_level`, level);\n\n// 로그\nnode.status({fill:\"blue\", shape:\"dot\", text:`Tank ${tankNum}: ${level}%`});\n\n// 탱크별 출력\nlet outputIndex = parseInt(tankNum) - 1;  // 0-based index\nlet outputs = [null, null, null, null, null, null];\noutputs[outputIndex] = {payload: level, topic: `tank${tankNum}`};\n\nreturn outputs;",
        "outputs": 6,
        "timeout": "",
        "noerr": 0,
        "x": 380,
        "y": 420,
        "wires": [
            ["ui_tank01_level"],
            ["ui_tank02_level"],
            ["ui_tank03_level"],
            ["ui_tank04_level"],
            ["ui_tank05_level"],
            ["ui_tank06_level"]
        ]
    },
