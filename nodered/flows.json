    {
        "id": "process_air_data",
        "type": "function",
        "z": "main_tab",
        "name": "대기 데이터 처리",
        "func": "// 대기 센서 데이터 처리\nconst zoneId = msg.topic.split('/')[2];\nconst data = msg.payload;\n\n// 전역 컨텍스트에 저장\nconst airData = global.get('airData') || {};\nairData[zoneId] = {\n    zone_id: data.zone_id,\n    air_temp: data.air_temp,\n    air_humidity: data.air_humidity,\n    timestamp: data.timestamp,\n    rssi: data.rssi,\n    updated: new Date()\n};\nglobal.set('airData', airData);\n\n// 평균값 계산 트리거\nnode.send([msg, {payload: 'calculate_avg'}]);\n\nreturn null;",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 200,
        "wires": [
            ["save_to_influx_air"],
            ["calculate_air_avg"]
        ]
    },
    {
        "id": "calculate_air_avg",
        "type": "function",
        "z": "main_tab",
        "name": "대기 평균값 계산",
        "func": "// 대기 센서 평균값 계산 (3개)\nconst airData = global.get('airData') || {};\nconst zoneIds = Object.keys(airData);\n\nif (zoneIds.length === 0) {\n    return null;\n}\n\nlet sumTemp = 0;\nlet sumHumidity = 0;\nlet validCount = 0;\n\n// 최근 1분 이내 데이터만 사용\nconst oneMinuteAgo = new Date(Date.now() - 60000);\n\nzoneIds.forEach(zoneId => {\n    const data = airData[zoneId];\n    if (data.updated > oneMinuteAgo) {\n        sumTemp += data.air_temp;\n        sumHumidity += data.air_humidity;\n        validCount++;\n    }\n});\n\nif (validCount === 0) {\n    return null;\n}\n\nconst avgData = {\n    avg_air_temp: (sumTemp / validCount).toFixed(1),\n    avg_air_humidity: (sumHumidity / validCount).toFixed(1),\n    valid_sensor_count: validCount,\n    total_sensors: 3,\n    timestamp: Date.now()\n};\n\n// 전역 컨텍스트에 저장\nglobal.set('airAvg', avgData);\n\nmsg.payload = avgData;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 240,
        "wires": [
            ["display_air_avg"]
        ]
    },
