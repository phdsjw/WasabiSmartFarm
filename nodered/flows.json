    {
        "id": "process_actuator_state",
        "type": "function",
        "z": "main_tab",
        "name": "액추에이터 상태 처리",
        "func": "// 액추에이터 상태 처리\nconst data = msg.payload;\n\n// 전역 컨텍스트에 저장\nglobal.set('actuatorState', {\n    irrigation_pump: data.irrigation_pump,\n    drainage_pump: data.drainage_pump,\n    fan: data.fan,\n    led: data.led,\n    emergency_stop: data.emergency_stop,\n    total_irrigation_time: data.total_irrigation_time,\n    total_drainage_time: data.total_drainage_time,\n    irrigation_count: data.irrigation_count,\n    drainage_count: data.drainage_count,\n    uptime: data.uptime,\n    rssi: data.rssi,\n    updated: new Date()\n});\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 400,
        "wires": [
            ["display_actuator_state"]
        ]
    },
    {
        "id": "check_irrigation_condition",
        "type": "function",
        "z": "main_tab",
        "name": "관수 조건 체크",
        "func": "// 자동 관수 제어 로직\nconst autoMode = global.get('autoIrrigationMode') || false;\n\nif (!autoMode) {\n    return null;\n}\n\nconst soilAvg = msg.payload;\nconst lastIrrigation = global.get('lastIrrigationTime') || 0;\nconst now = Date.now();\n\n// 최소 1시간 간격\nconst oneHour = 3600000;\nif (now - lastIrrigation < oneHour) {\n    node.status({fill:\"yellow\", shape:\"ring\", text:`대기중 (${Math.round((oneHour - (now - lastIrrigation))/60000)}분 남음)`});\n    return null;\n}\n\n// 조건 체크\nconst moisture = parseFloat(soilAvg.avg_soil_moisture);\nconst ec = parseFloat(soilAvg.avg_soil_ec);\nconst temp = parseFloat(soilAvg.avg_soil_temp);\n\nconst moistureThreshold = global.get('irrigationMoistureThreshold') || 95;\nconst ecThreshold = global.get('irrigationECThreshold') || 5.0;\nconst tempThreshold = global.get('irrigationTempThreshold') || 22;\n\nlet needsIrrigation = false;\nlet reason = \"\";\n\nif (moisture <= moistureThreshold) {\n    needsIrrigation = true;\n    reason = `토양 습도 낮음 (${moisture}% <= ${moistureThreshold}%)`;\n} else if (ec >= ecThreshold) {\n    needsIrrigation = true;\n    reason = `토양 EC 높음 (${ec} >= ${ecThreshold})`;\n} else if (temp >= tempThreshold) {\n    needsIrrigation = true;\n    reason = `토양 온도 높음 (${temp}°C >= ${tempThreshold}°C)`;\n}\n\nif (needsIrrigation) {\n    node.status({fill:\"green\", shape:\"dot\", text:`관수 시작: ${reason}`});\n    global.set('lastIrrigationTime', now);\n    global.set('lastIrrigationReason', reason);\n    \n    msg.payload = {\n        action: \"start_irrigation\",\n        reason: reason,\n        moisture: moisture,\n        ec: ec,\n        temp: temp,\n        duration: 240000  // 4분 (240초)\n    };\n    return msg;\n} else {\n    node.status({fill:\"blue\", shape:\"ring\", text:\"조건 미충족\"});\n    return null;\n}\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 140,
        "wires": [
            ["start_irrigation"]
        ]
    },
