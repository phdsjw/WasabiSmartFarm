        "name": "관수 로그 저장",
        "func": "const reason = global.get('lastIrrigationReason') || '수동';\nconst soilAvg = global.get('soilAvg') || {};\n\nmsg.payload = [\n    {\n        measurement: 'irrigation_log',\n        fields: {\n            reason: reason,\n            avg_soil_moisture: parseFloat(soilAvg.avg_soil_moisture) || 0,\n            avg_soil_ec: parseFloat(soilAvg.avg_soil_ec) || 0,\n            avg_soil_temp: parseFloat(soilAvg.avg_soil_temp) || 0,\n            duration_seconds: 240\n        },\n        timestamp: new Date()\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
