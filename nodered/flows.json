    {
        "id": "save_to_influx_soil",
        "type": "function",
        "z": "main_tab",
        "name": "InfluxDB 저장 준비 (토양)",
        "func": "// InfluxDB 포맷으로 변환\nconst data = msg.payload;\nconst tankId = msg.topic.split('/')[2];\n\nmsg.payload = [\n    {\n        measurement: 'soil_sensor',\n        tags: {\n            tank_id: tankId\n        },\n        fields: {\n            soil_temp: data.soil_temp,\n            soil_moisture: data.soil_moisture,\n            soil_ec: data.soil_ec,\n            soil_ph: data.soil_ph,\n            rssi: data.rssi\n        },\n        timestamp: new Date(data.timestamp)\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 100,
        "wires": [
            []
        ]
    },
    {
        "id": "save_to_influx_air",
        "type": "function",
        "z": "main_tab",
        "name": "InfluxDB 저장 준비 (대기)",
        "func": "// InfluxDB 포맷으로 변환\nconst data = msg.payload;\nconst zoneId = msg.topic.split('/')[2];\n\nmsg.payload = [\n    {\n        measurement: 'air_sensor',\n        tags: {\n            zone_id: zoneId\n        },\n        fields: {\n            air_temp: data.air_temp,\n            air_humidity: data.air_humidity,\n            rssi: data.rssi\n        },\n        timestamp: new Date(data.timestamp)\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 200,
        "wires": [
            []
        ]
    },
    {
        "id": "save_to_influx_water",
        "type": "function",
        "z": "main_tab",
        "name": "InfluxDB 저장 준비 (수조)",
        "func": "// InfluxDB 포맷으로 변환\nconst data = msg.payload;\n\nmsg.payload = [\n    {\n        measurement: 'water_tank_sensor',\n        tags: {\n            location: 'main_tank'\n        },\n        fields: {\n            water_temp: data.water_temp,\n            water_ph: data.water_ph,\n            water_tds: data.water_tds,\n            water_ec: data.water_ec,\n            rssi: data.rssi\n        },\n        timestamp: new Date(data.timestamp)\n    }\n];\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 300,
        "wires": [
            []
