        "id": "mqtt_in_soil_all",
        "type": "mqtt in",
        "z": "main_tab",
        "name": "토양 센서 전체",
        "topic": "sensor/soil/+/data",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker",
        "nl": false,
        "rap": true,
