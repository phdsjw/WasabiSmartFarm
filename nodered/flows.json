    {
        "id": "process_soil_data",
        "type": "function",
        "z": "main_tab",
        "name": "토양 데이터 처리",
        "func": "// 토양 센서 데이터 처리\nconst tankId = msg.topic.split('/')[2];\nconst data = msg.payload;\n\n// 전역 컨텍스트에 저장\nconst soilData = global.get('soilData') || {};\nsoilData[tankId] = {\n    tank_id: data.tank_id,\n    soil_temp: data.soil_temp,\n    soil_moisture: data.soil_moisture,\n    soil_ec: data.soil_ec,\n    soil_ph: data.soil_ph,\n    timestamp: data.timestamp,\n    rssi: data.rssi,\n    updated: new Date()\n};\nglobal.set('soilData', soilData);\n\n// 평균값 계산 트리거\nnode.send([msg, {payload: 'calculate_avg'}]);\n\nreturn null;",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 320,
        "y": 100,
        "wires": [
            ["save_to_influx_soil"],
            ["calculate_soil_avg"]
        ]
    },
    {
        "id": "calculate_soil_avg",
        "type": "function",
        "z": "main_tab",
        "name": "토양 평균값 계산",
        "func": "// 토양 센서 평균값 계산 (18개)\nconst soilData = global.get('soilData') || {};\nconst tankIds = Object.keys(soilData);\n\nif (tankIds.length === 0) {\n    return null;\n}\n\nlet sumTemp = 0;\nlet sumMoisture = 0;\nlet sumEC = 0;\nlet sumPH = 0;\nlet validCount = 0;\n\n// 최근 1분 이내 데이터만 사용\nconst oneMinuteAgo = new Date(Date.now() - 60000);\n\ntankIds.forEach(tankId => {\n    const data = soilData[tankId];\n    if (data.updated > oneMinuteAgo) {\n        sumTemp += data.soil_temp;\n        sumMoisture += data.soil_moisture;\n        sumEC += data.soil_ec;\n        sumPH += data.soil_ph;\n        validCount++;\n    }\n});\n\n// 최소 12개 센서 필요\nif (validCount < 12) {\n    node.warn(`유효한 센서 ${validCount}개 (최소 12개 필요)`);\n    return null;\n}\n\nconst avgData = {\n    avg_soil_temp: (sumTemp / validCount).toFixed(1),\n    avg_soil_moisture: (sumMoisture / validCount).toFixed(1),\n    avg_soil_ec: (sumEC / validCount).toFixed(2),\n    avg_soil_ph: (sumPH / validCount).toFixed(2),\n    valid_sensor_count: validCount,\n    total_sensors: 18,\n    timestamp: Date.now()\n};\n\n// 전역 컨텍스트에 저장\nglobal.set('soilAvg', avgData);\n\nmsg.payload = avgData;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 140,
        "wires": [
            ["display_soil_avg", "check_irrigation_condition"]
        ]
    },
